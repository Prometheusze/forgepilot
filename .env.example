# ForgePilot Local Environment Configuration Example
#
# IMPORTANT SECURITY NOTE:
# Model API keys (such as GEMINI_API_KEY, OPENAI_API_KEY, etc.) must NEVER be placed in .env
# or in the codebase. All provider credentials are configured securely inside the local TrueForge UI
# (Settings -> Models). TrueForge manages secret resolution and authentication locally.

# TrueForge server base URL (default: http://localhost:8790)
TRUEFORGE_BASE_URL=http://localhost:8790

# Optional outbound host allowlist for TrueForge network sandboxing
OUTBOUND_URL_ALLOWED_HOSTS='["127.0.0.1"]'
