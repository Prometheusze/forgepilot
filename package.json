{
  "name": "forgepilot",
  "displayName": "ForgePilot",
  "version": "0.0.1",
  "publisher": "local",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.147.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "forgepilot.smokeTest",
        "title": "TrueForge Smoke Test",
        "category": "ForgePilot"
      },
      {
        "command": "forgepilot.inlineEdit",
        "title": "Inline Edit",
        "category": "ForgePilot"
      },
      {
        "command": "forgepilot.acceptHunk",
        "title": "Accept Hunk",
        "category": "ForgePilot"
      },
      {
        "command": "forgepilot.rejectHunk",
        "title": "Reject Hunk",
        "category": "ForgePilot"
      },
      {
        "command": "forgepilot.acceptAllInFile",
        "title": "Accept All Hunks in File",
        "category": "ForgePilot"
      },
      {
        "command": "forgepilot.rejectAllInFile",
        "title": "Reject All Hunks in File",
        "category": "ForgePilot"
      },
      {
        "command": "forgepilot.undoLastEdit",
        "title": "Undo Last Edit",
        "category": "ForgePilot"
      },
      {
        "command": "forgepilot.cancelRun",
        "title": "Cancel Run",
        "category": "ForgePilot"
      }
    ],
    "keybindings": [
      {
        "command": "forgepilot.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "forgepilot.cancelRun",
        "key": "escape",
        "when": "forgepilot.running"
      }
    ],
    "configuration": {
      "title": "ForgePilot",
      "properties": {
        "forgepilot.trueforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of the TrueForge server harness"
        },
        "forgepilot.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Ordered model candidates (primary, then fallbacks) configured in TrueForge"
        }
      }
    }
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.145.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^7.0.2"
  }
}
